{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeSweep",
  "version": "2.1.0-alpha.1",
  "identifier": "com.srpedrax.nodesweep",
  "build": {
    "beforeDevCommand": "npm --prefix client run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix client run build",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "NodeSweep", "width": 1180, "height": 820, "minWidth": 760, "minHeight": 600, "center": true, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
